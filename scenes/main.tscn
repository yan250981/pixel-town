[node name="RestaurantSign" type="Area2D" parent="Entities"]
position = Vector2(740, 752)
collision_layer = 2
collision_mask = 0
monitoring = false
script = ExtResource("4_interactable")
title = "饭馆"
prompt_verb = "查看"
lines = PackedStringArray("红烧鱼刚出锅，热气顺着屋檐往上飘。", "老板从窗口探出头：今天有刚上岸的石斑鱼。")

[node name="Focus" type="CollisionShape2D" parent="Entities/RestaurantSign"]
shape = SubResource("Circle_focus")

[node name="FruitShopSign" type="Area2D" parent="Entities"]
position = Vector2(1120, 768)
collision_layer = 2
collision_mask = 0
monitoring = false
script = ExtResource("4_interactable")
title = "聚目美坊"
prompt_verb = "逛一逛"
lines = PackedStringArray("红毛丹、山竹、芒果堆成了小山。", "老板娘头也不抬：随便看，别捏坏果子。")

[node name="Focus" type="CollisionShape2D" parent="Entities/FruitShopSign"]
shape = SubResource("Circle_focus")

[node name="NoticeBoardSign" type="Area2D" parent="Entities"]
position = Vector2(742, 800)
collision_layer = 2
collision_mask = 0
monitoring = false
script = ExtResource("4_interactable")
title = "告示栏"
prompt_verb = "阅读"
lines = PackedStringArray("小镇告示", "· 明晚七点，码头有渔火集市。", "· 迷路的旅人，请到饭馆问路。")

[node name="Focus" type="CollisionShape2D" parent="Entities/NoticeBoardSign"]
shape = SubResource("Circle_focus")

[node name="JuiceStallSign" type="Area2D" parent="Entities"]
position = Vector2(1065, 812)
collision_layer = 2
collision_mask = 0
monitoring = false
script = ExtResource("4_interactable")
title = "果汁摊"
prompt_verb = "品尝"
lines = PackedStringArray("冰镇椰子水，五块钱一杯。", "甜得像是把整片海滩都榨了进去。")

[node name="Focus" type="CollisionShape2D" parent="Entities/JuiceStallSign"]
